{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "paths": {
      "@penguinharness/plugin-*/server": ["./plugins/*/src/server/index.ts"],
      "@penguinharness/plugin-*/web": ["./plugins/*/src/web/index.ts"],
      "@penguinharness/plugin-browser/server/*": ["./plugins/browser/src/server/*"],
      "@penguinharness/plugin-db/server": ["./plugins/db/src/index.ts"],
      "@penguinharness/plugin-machines/server/http/json-answer": [
        "./packages/server/src/http/json-answer.ts"
      ],
      "@penguinharness/plugin-machines/server/http/sse": ["./packages/server/src/http/sse.ts"],
      "@penguinharness/plugin-machines/server/socket/stream-answer": [
        "./packages/server/src/socket/stream-answer.ts"
      ],
      "@penguinharness/plugin-messaging/server/messaging/*": [
        "./plugins/messaging/src/server/messaging/*"
      ],
      "@penguinharness/plugin-messaging/web/*": ["./plugins/messaging/src/web/*"],
      "@penguinharness/plugin-models/web/*": ["./plugins/models/src/web/*"],
      "@penguinharness/plugin-sessions/web/*": ["./plugins/sessions/src/web/*"],
      "@penguinharness/plugin-terminal/server/*": ["./plugins/terminal/src/server/*"],
      "@prismshadow/penguin-core": ["./packages/core/src/index.ts"],
      "@prismshadow/penguin-core/*": ["./packages/core/src/*"],
      "@prismshadow/penguin-core/context-limits": ["./packages/core/src/llm/context-limits.ts"],
      "@prismshadow/penguin-core/model-connection": [
        "./packages/core/src/state/model-connection.ts"
      ],
      "@prismshadow/penguin-server": ["./packages/server/src/index.ts"],
      "@prismshadow/penguin-server/*": ["./packages/server/src/*"],
      "@prismshadow/penguin-server/api": ["./packages/server/src/api/types.ts"],
      "@prismshadow/penguin-server/cli-shim": ["./packages/server/src/services/cli-shim.ts"],
      "@prismshadow/penguin-web/*": ["./packages/web/src/*"]
    }
  }
}
